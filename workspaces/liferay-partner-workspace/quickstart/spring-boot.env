LIFERAY_ROUTES_CLIENT_EXTENSION=/etc/liferay/lxc/ext-init-metadata
LIFERAY_ROUTES_DXP=/etc/liferay/lxc/dxp-metadata
SERVER_PORT=58081
SPRING_RABBITMQ_HOST=rabbbitmq
SPRING_RABBITMQ_LISTENER_SIMPLE_ACKNOWLEDGE_MODE=manual
SPRING_RABBITMQ_LISTENER_SIMPLE_DEFAULT_REQUEUE_REJECTED=false
SPRING_RABBITMQ_PASSWORD=test
SPRING_RABBITMQ_PORT=5671
SPRING_RABBITMQ_REQUESTED_HEARTBEAT=60
SPRING_RABBITMQ_SSL_ENABLED=true
SPRING_RABBITMQ_TEMPLATE_DEFAULT_EXCHANGE=test_exchange
SPRING_RABBITMQ_TEMPLATE_DEFAULT_RECEIVE_QUEUE=test_queue
SPRING_RABBITMQ_USERNAME=test